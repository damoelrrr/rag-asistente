# Copia este archivo como .env y pon tu clave. NUNCA subas .env al repositorio.
LLM_PROVIDER=groq
GROQ_API_KEY=tu-clave-de-groq
LLM_MODEL=openai/gpt-oss-120b

# Alternativas: LLM_PROVIDER=anthropic + ANTHROPIC_API_KEY, o LLM_PROVIDER=openai + OPENAI_API_KEY

# Juez de Ragas (solo para eval/run_eval.py). Un modelo distinto reparte los límites de uso del plan gratuito.
JUDGE_PROVIDER=groq
JUDGE_MODEL=openai/gpt-oss-20b
RAGAS_STRICTNESS=1
RAGAS_WORKERS=1
